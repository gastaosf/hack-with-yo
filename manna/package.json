{
  "name": "manna-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "dev:web": "turbo run dev --filter=@manna/web",
    "dev:mobile": "turbo run dev --filter=@manna/mobile"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}

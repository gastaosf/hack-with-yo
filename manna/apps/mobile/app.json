{
  "expo": {
    "name": "Manna",
    "slug": "manna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1321"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.manna.app" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0d1321" },
      "package": "com.manna.app"
    },
    "plugins": ["expo-router", "expo-font", "expo-secure-store"],
    "scheme": "manna",
    "experiments": { "typedRoutes": true }
  }
}
